#. Plugin Name of the plugin
#: hermaily.php
msgid "Hermaily"
msgstr "Hermaily"

#. Plugin URI of the plugin
#: hermaily.php
msgid "https://hermaily.com/en/docs/"
msgstr "https://hermaily.com/docs/"

#. Description of the plugin
#: hermaily.php
msgid "Sends WordPress email through the Hermaily HTTPS API, from the European Union. No SMTP ports needed."
msgstr "Envía el correo de WordPress a través de la API HTTPS de Hermaily, desde la Unión Europea. Sin puertos SMTP."

#. Author of the plugin
#: hermaily.php
msgid "David Marín Carreño (DaveFX)"
msgstr "David Marín Carreño (DaveFX)"

#. Author URI of the plugin
#: hermaily.php
msgid "https://davefx.com"
msgstr "https://davefx.com"

#: includes/class-hermaily-client.php:55
msgid "Invalid message id."
msgstr "Identificador de mensaje no válido."

#: includes/class-hermaily-client.php:124
msgid "Hermaily sent an answer that could not be read."
msgstr "Hermaily envió una respuesta que no se pudo leer."

#. translators: 1: HTTP status code, 2: explanation from Hermaily.
#: includes/class-hermaily-client.php:136
#, php-format
msgid "Hermaily answered %1$d: %2$s"
msgstr "Hermaily respondió %1$d: %2$s"

#: includes/class-hermaily-log.php:196
msgid "This message never reached Hermaily."
msgstr "Este mensaje nunca llegó a Hermaily."

#. translators: %d: the most recipients a message may have.
#: includes/class-hermaily-mailer.php:153
#, php-format
msgid "Hermaily accepts at most %d recipients per message."
msgstr "Hermaily admite como máximo %d destinatarios por mensaje."

#. translators: %s: file path.
#: includes/class-hermaily-mailer.php:313
#, php-format
msgid "Could not read the attachment %s."
msgstr "No se pudo leer el adjunto %s."

#: includes/class-hermaily-settings.php:165
#: includes/class-hermaily-settings.php:339
msgid "Settings"
msgstr "Ajustes"

#: includes/class-hermaily-settings.php:187
msgid "Sorry, you are not allowed to manage Hermaily."
msgstr "Lo siento, no tienes permiso para gestionar Hermaily."

#: includes/class-hermaily-settings.php:269
msgid "Hermaily test email"
msgstr "Correo de prueba de Hermaily"

#. translators: %s: site name.
#: includes/class-hermaily-settings.php:272
#, php-format
msgid "This test email from %s was sent through the Hermaily API. If you are reading it, sending works."
msgstr "Este correo de prueba de %s se ha enviado a través de la API de Hermaily. Si lo estás leyendo, el envío funciona."

#. translators: 1: recipient, 2: Hermaily message id.
#: includes/class-hermaily-settings.php:281
#, php-format
msgid "Hermaily accepted the test email to %1$s (id %2$s). Its status appears in the Log tab."
msgstr "Hermaily ha aceptado el correo de prueba para %1$s (id %2$s). Su estado aparece en la pestaña Registro."

#. translators: %s: recipient.
#: includes/class-hermaily-settings.php:284
#, php-format
msgid "The test email to %s was sent, but not through Hermaily: another plugin is handling wp_mail()."
msgstr "El correo de prueba para %s se ha enviado, pero no a través de Hermaily: otro plugin se está encargando de wp_mail()."

#. translators: 1: recipient, 2: error message.
#: includes/class-hermaily-settings.php:287
#, php-format
msgid "The test email to %1$s could not be sent. %2$s"
msgstr "No se pudo enviar el correo de prueba a %1$s. %2$s"

#: includes/class-hermaily-settings.php:340
msgid "Log"
msgstr "Registro"

#: includes/class-hermaily-settings.php:385
msgid "Settings saved."
msgstr "Ajustes guardados."

#: includes/class-hermaily-settings.php:392
msgid "The default sender is not a valid email address. Nothing was saved."
msgstr "El remitente por defecto no es una dirección de correo válida. No se ha guardado nada."

#: includes/class-hermaily-settings.php:394
msgid "Save an API key before sending the test email."
msgstr "Guarda una clave de API antes de enviar el correo de prueba."

#. translators: %s: link to the API keys page of the Hermaily dashboard.
#: includes/class-hermaily-settings.php:418
#, php-format
msgid "Create an API key in %s and paste it below. From then on, every email WordPress sends goes through Hermaily."
msgstr "Crea una clave de API en %s y pégala aquí debajo. A partir de entonces, todo el correo que envíe WordPress saldrá por Hermaily."

#: includes/class-hermaily-settings.php:419
msgid "your Hermaily dashboard"
msgstr "tu panel de Hermaily"

#. translators: %s: domain.
#: includes/class-hermaily-settings.php:426
#, php-format
msgid "The domain %s is not verified yet: Hermaily will not send from it until its DNS records are in place. Check it in your Hermaily dashboard."
msgstr "El dominio %s aún no está verificado: Hermaily no enviará desde él hasta que sus registros DNS estén en su sitio. Revísalo en tu panel de Hermaily."

#. translators: 1: sender address, 2: domain.
#: includes/class-hermaily-settings.php:430
#, php-format
msgid "The default sender %1$s is not on %2$s, the domain of this API key: Hermaily will refuse it."
msgstr "El remitente por defecto %1$s no es de %2$s, el dominio de esta clave de API: Hermaily lo rechazará."

#. translators: %s: error message.
#: includes/class-hermaily-settings.php:434
#, php-format
msgid "The API key could not be checked. %s"
msgstr "No se pudo comprobar la clave de API. %s"

#: includes/class-hermaily-settings.php:443
msgid "API key"
msgstr "Clave de API"

#: includes/class-hermaily-settings.php:446
msgid "Defined by the HERMAILY_API_KEY constant in wp-config.php."
msgstr "Definida con la constante HERMAILY_API_KEY en wp-config.php."

#: includes/class-hermaily-settings.php:448
msgid "Saved. Paste a new key to replace it."
msgstr "Guardada. Pega una clave nueva para sustituirla."

#: includes/class-hermaily-settings.php:451
msgid "Remove the saved key (WordPress will send email by itself again)"
msgstr "Borrar la clave guardada (WordPress volverá a enviar el correo por su cuenta)"

#: includes/class-hermaily-settings.php:453
msgid "You can also define it in wp-config.php:"
msgstr "También puedes definirla en wp-config.php:"

#. translators: %s: domain.
#: includes/class-hermaily-settings.php:460
#, php-format
msgid "This key sends from %s (verified)."
msgstr "Esta clave envía desde %s (verificado)."

#. translators: %s: domain.
#: includes/class-hermaily-settings.php:462
#, php-format
msgid "This key sends from %s (not verified yet)."
msgstr "Esta clave envía desde %s (aún sin verificar)."

#: includes/class-hermaily-settings.php:469
msgid "Default sender email"
msgstr "Correo del remitente por defecto"

#: includes/class-hermaily-settings.php:471
msgid "Used when a message does not say who it is from. It must be on the domain of your API key."
msgstr "Se usa cuando un mensaje no dice quién lo envía. Debe ser del dominio de tu clave de API."

#: includes/class-hermaily-settings.php:474
msgid "Default sender name"
msgstr "Nombre del remitente por defecto"

#: includes/class-hermaily-settings.php:478
msgid "Force sender"
msgstr "Forzar remitente"

#: includes/class-hermaily-settings.php:479
msgid "Always send from the default sender"
msgstr "Enviar siempre desde el remitente por defecto"

#: includes/class-hermaily-settings.php:480
msgid "For plugins that set their own sender, such as contact forms that send \"from\" the visitor. The original sender becomes the Reply-To, so replies still reach them."
msgstr "Para los plugins que ponen su propio remitente, como los formularios de contacto que envían «desde» el visitante. El remitente original pasa a ser el Reply-To, así que las respuestas le siguen llegando."

#: includes/class-hermaily-settings.php:483
msgid "Keep the log for"
msgstr "Conservar el registro durante"

#: includes/class-hermaily-settings.php:484
msgid "days"
msgstr "días"

#: includes/class-hermaily-settings.php:485
msgid "The log keeps date, recipients, subject and status, never the content. 0 turns it off."
msgstr "El registro guarda fecha, destinatarios, asunto y estado, nunca el contenido. Con 0 se desactiva."

#: includes/class-hermaily-settings.php:493
msgid "Send a test email"
msgstr "Enviar un correo de prueba"

#: includes/class-hermaily-settings.php:497
msgid "Send to"
msgstr "Enviar a"

#: includes/class-hermaily-settings.php:499
msgid "Send test email"
msgstr "Enviar correo de prueba"

#: includes/class-hermaily-settings.php:514
msgid "The log is turned off in the settings."
msgstr "El registro está desactivado en los ajustes."

#. translators: %d: number of days.
#: includes/class-hermaily-settings.php:520
#, php-format
msgid "Messages of the last %d day. Statuses are as of the last check: open a message or refresh to ask Hermaily again."
msgid_plural "Messages of the last %d days. Statuses are as of the last check: open a message or refresh to ask Hermaily again."
msgstr[0] "Mensajes del último día. Los estados son los de la última consulta: abre un mensaje o actualiza para volver a preguntar a Hermaily."
msgstr[1] "Mensajes de los últimos %d días. Los estados son los de la última consulta: abre un mensaje o actualiza para volver a preguntar a Hermaily."

